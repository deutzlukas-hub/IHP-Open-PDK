//******************************************************************************
//
//
//******************************************************************************
// MOSLV model aggregator
//******************************************************************************
//
// sg13g2_lv PSP103VA model card, split into per-polarity paramset files.
// Each per-polarity file emits two same-named `sg13g2_lv_*mos_psp` bodies:
// one with `mm_ok = 0` (no mismatch) and one with `mm_ok = 1` (mismatch).
// Mismatch dispatch happens at instantiation time via the `mm_ok` range
// restriction, matching the moscap pattern.
//
// NMOS paramset: `paramsets/sg13g2_moslv_nmos.va`
// PMOS paramset: `paramsets/sg13g2_moslv_pmos.va`
// (c) Lukas Deutz 2026
//
//******************************************************************************

// compiler directive
`pragma modelgen nogen-module
// include generic model
`include "psp103.va"
// include specialized paramsets
`include "paramsets/sg13g2_moslv_nmos.va"
`include "paramsets/sg13g2_moslv_pmos.va"
