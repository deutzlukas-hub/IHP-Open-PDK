endparamset

(* desc="isolbox diode: SPICE area-cap diode of deep-nwell clamp, L176." *)
paramset dincaparea_mod sp_diode
    parameter real area = 1 from [0:inf);
    parameter real pj = 0 from [0:inf);
    .area = area;
    .pj   = pj;
    .level = 1;
    .tlev  = 2;
    .tlevc = 0;
    .tnom  = 27;
    .is   = 1e-25;
    .cjo  = 967.2e-18;
    .cjsw = 436e-18;
    .m    = 0.3436;
    .mjsw = 0.3234;
    .vj   = 0.7312;
